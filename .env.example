# ==========================================
# ENGINITY Marketplace — Environment Template
# Copy this file to `.env` and fill in your credentials.
# Never commit real keys or tokens to `.env.example`.
# ==========================================

# Supabase Public Configuration (Client + Server)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Supabase Server-Only Service Role Key (Optional, for fulfillment & server-side admin operations)
SUPABASE_SERVICE_ROLE_KEY=""

# Public Storefront Base URL
SITE_URL="https://enginity-store-s8dx.vercel.app"

# AI Shopping Assistant Webhook (Server-Side Proxy Target)
N8N_ASSISTANT_WEBHOOK_URL="https://your-n8n-domain.example.com/webhook/agent-enginity-store"

# XPay Checkout & Webhook Security (Server-Only)
XPAY_ALLOWED_HOSTS="checkout.xpay.app,community.xpay.app,xpay.app,staging.xpay.app"
XPAY_WEBHOOK_SECRET="your-xpay-webhook-secret"

# Order Fulfillment Webhook (Server-Only)
N8N_FULFILLMENT_WEBHOOK_URL="https://your-n8n-domain.example.com/webhook/order-fulfillment"
N8N_WEBHOOK_SECRET="your-n8n-webhook-secret"

# Admin Image Upload Proxy (Server-Only)
IMGBB_API_KEY="your-imgbb-api-key"
